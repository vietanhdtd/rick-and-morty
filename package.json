{
  "name": "living-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.2.21",
  "engines": {
    "bun": ">=1.2.21",
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "prepare": "panda codegen && panda cssgen --outfile src/panda.css"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "^5.90.3",
    "@tanstack/react-router": "^1.114.3",
    "lenis": "^1.3.17",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@pandacss/dev": "^1.3.1",
    "@tanstack/router-plugin": "^1.114.3",
    "@types/node": "^22.18.6",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "@playwright/test": "^1.55.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5"
  }
